# Security headers for every response. CSP is enforceable since 2026-07-07.
# This synchronized root/public file is the build template and legacy fallback.
# `npm run build` replaces its compatibility script policy in `out/_headers`
# with per-route SHA-256 hashes for every executable Next.js inline bootstrap
# and Flight script. `script-src-attr` keeps inline handlers disabled in both.
# Inline <style> blocks and style="" attributes are also still used.
# External allowances: Font Awesome CSS + webfonts from cdnjs; Lora +
# Noto Sans Myanmar via Google Fonts (theme.css @import -> fonts.googleapis.com
# stylesheet -> fonts.gstatic.com woff2) — without these two hosts the font
# @import is CSP-blocked and every page silently falls back to Georgia.
# Cloudflare Web Analytics is automatically injected on the custom domain;
# its exact beacon path and versioned subpath are narrowly allowlisted while
# reports stay same-origin.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/products.json
  Cache-Control: no-store, max-age=0

# Next 16's static export can reuse chunk filenames across rebuilds. Require
# browser revalidation so a new preview/deployment cannot strand returning
# visitors on stale CSS or JavaScript under an unchanged URL. Cloudflare Pages
# still supplies ETags, so unchanged chunks normally resolve with a 304.
/_next/static/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400

/style.css
  Cache-Control: public, max-age=86400

# /images/* is cached immutably for 30 days — great for product/review art that
# never changes under the same name.
/images/*
  Cache-Control: public, max-age=2592000, immutable

# ...but the two BRAND marks DO change under the same name — Kimi replaced both
# on 2026-08-24 and every visitor kept the old bytes, because `immutable` tells a
# browser not even to revalidate.
#
# ⚠️ MEASURED 2026-08-24: these two rules do NOT override the wildcard above.
# Cloudflare MERGES the Cache-Control directives of every matching rule, so a
# fresh MISS on /images/favicon.svg returns
#     public, max-age=14400, immutable, must-revalidate
# — `must-revalidate` from here, `immutable` still from the wildcard, and a
# max-age that is neither value. `immutable` surviving is the part that matters:
# it means a same-name replacement still will not reach a browser that has the
# old copy.
#
# So the working convention is a VERSION BUMP, not this rule: when a brand mark
# changes, bump `?v=N` at its reference sites (src/app/layout.tsx,
# src/app/page.tsx, src/components/layout/SiteHeader.tsx,
# src/components/catalog/PlanModal.tsx). A new URL is a new cache key for the CDN
# and for browsers holding an immutable copy. `?v=2` is what actually delivered
# Kimi's marks; these rules only shorten the window a little.
#
# The real fix, if it ever matters enough: move brand marks off /images/ (e.g.
# /brand/) so only ONE rule matches them. That also has to account for
# functions/images/[name].js, which owns /images/*.
#
# Product and review art keeps the 30 immutable days, which is correct — those
# never change under the same name.
/images/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/images/brand-logo.png
  Cache-Control: public, max-age=3600, must-revalidate

# Payment QR images CAN be replaced in place and must NEVER serve stale (money
# path). These override the immutable rule above (listed after it + more
# specific, so they win under either CF precedence rule). Browsers always
# revalidate -> a swapped QR is picked up on the next load, no rename needed.
# (Stable filenames on purpose: fingerprint-renaming broke when a deploy shipped
# the HTML but not the renamed binary. Trailing '*' still covers any future
# versioned name if you ever do fingerprint one.)
/images/kpay-qr*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/images/wavepay-qr*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/images/ayapay-qr*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
